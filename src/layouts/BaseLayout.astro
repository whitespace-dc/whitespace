---
import '../styles/global.css';
import { CATEGORIES } from '../data/categories';

interface Props {
  title?: string;
}

const { title = 'Whitespace' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen">
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-center justify-between h-14">
          <a href={base} class="flex items-baseline gap-2 hover:opacity-80 transition">
            <span class="text-lg font-bold tracking-tight">Whitespace</span>
            <span class="text-xs text-slate-500" data-en>DC Intel</span>
            <span class="text-xs text-slate-500" data-zh>数据中心情报</span>
          </a>
          <div class="flex items-center gap-3">
            <input
              type="search"
              id="search"
              placeholder="Search…"
              data-en
              class="hidden sm:block px-3 py-1.5 text-sm border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-slate-400 w-48"
            />
            <input
              type="search"
              id="search-zh"
              placeholder="搜索…"
              data-zh
              class="hidden sm:block px-3 py-1.5 text-sm border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-slate-400 w-48"
            />
            <button
              id="lang-toggle"
              class="px-3 py-1.5 text-xs font-medium border border-slate-300 rounded-md hover:bg-slate-100 transition"
              aria-label="Toggle language"
            >
              <span data-en>中文</span>
              <span data-zh>EN</span>
            </button>
          </div>
        </div>
        <nav class="overflow-x-auto -mx-4 px-4 pb-2">
          <ul class="flex gap-1 text-sm whitespace-nowrap">
            {CATEGORIES.map((cat) => (
              <li>
                <a
                  href={`${base}/category/${cat.slug}`}
                  class="px-3 py-1.5 rounded-md hover:bg-slate-100 text-slate-700 hover:text-slate-900 transition inline-block"
                >
                  <span data-en>{cat.en}</span>
                  <span data-zh>{cat.zh}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-slate-200 mt-16 py-8 text-center text-xs text-slate-500">
      <span data-en>Internal — Whitespace DC team</span>
      <span data-zh>内部 — Whitespace 数据中心团队</span>
    </footer>

    <div
      id="internal-warning"
      class="fixed inset-0 z-[100] bg-black/60 items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="iw-title"
    >
      <div class="bg-white rounded-lg max-w-md w-full p-6 shadow-2xl">
        <h2 id="iw-title" class="text-lg font-semibold mb-3">
          <span data-en>Internal Use Only</span>
          <span data-zh>仅限内部使用</span>
        </h2>
        <p class="text-sm text-slate-700 mb-4 leading-relaxed">
          <span data-en>
            Whitespace is restricted to the internal data center planning team.
            Do not share, redistribute, screenshot for external audiences, or
            quote content beyond the team without permission.
          </span>
          <span data-zh>
            Whitespace 仅限数据中心规划团队内部使用。未经许可，请勿对外分享、转发、
            截图给团队外人员或引用内容。
          </span>
        </p>
        <button
          id="iw-ack"
          class="w-full px-4 py-2 bg-slate-900 text-white rounded hover:bg-slate-800 text-sm font-medium transition"
        >
          <span data-en>I understand</span>
          <span data-zh>我已知悉</span>
        </button>
      </div>
    </div>

    <script>
      // Bilingual toggle: flips data-lang on <html>; CSS hides/shows based on it.
      const LANG_KEY = 'ws-lang';
      const html = document.documentElement;
      const saved = localStorage.getItem(LANG_KEY);
      if (saved === 'zh' || saved === 'en') html.dataset.lang = saved;

      document.getElementById('lang-toggle')?.addEventListener('click', () => {
        const next = html.dataset.lang === 'en' ? 'zh' : 'en';
        html.dataset.lang = next;
        localStorage.setItem(LANG_KEY, next);
      });

      // Internal-use modal — shown once per device, dismissed on ack.
      const ACK_KEY = 'ws-internal-ack';
      const modal = document.getElementById('internal-warning');
      if (modal && !localStorage.getItem(ACK_KEY)) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
      document.getElementById('iw-ack')?.addEventListener('click', () => {
        localStorage.setItem(ACK_KEY, '1');
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
        document.body.style.overflow = '';
      });
    </script>

    <style is:global>
      html[data-lang='en'] [data-zh] {
        display: none !important;
      }
      html[data-lang='zh'] [data-en] {
        display: none !important;
      }
    </style>
  </body>
</html>
