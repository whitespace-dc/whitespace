---
import '../styles/global.css';
import { CATEGORIES } from '../data/categories';
import Bi from '../components/Bi.astro';

interface Props {
  title?: string;
  /** Meta description + og:description — pass summary_en from articles, a blurb from indexes. */
  description?: string;
  /** OpenGraph type: 'article' on article pages, defaults to 'website'. */
  ogType?: 'website' | 'article';
  /** Masthead today-line (revamp §2.1) — build-time stat rendered beside the language
   *  toggle. Date-anchored by the caller so a stale build never claims "today". */
  statLine?: { en: string; zh: string };
}

const {
  title = 'Whitespace',
  description = 'Whitespace — independent data-center intelligence. Corroborated, multi-source, bilingual (EN / 繁中).',
  ogType = 'website',
  statLine,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const path = Astro.url.pathname.replace(/\/$/, '');
const homeHref = base.replace(/\/$/, '');
const isHome = path === homeHref;
const catHref = (slug: string) => `${homeHref}/category/${slug}`;
const isActiveCat = (slug: string) => path === catHref(slug);
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {/* Matches the white sticky header, so mobile browser chrome blends instead of
        painting a navy band over a cream page. */}
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Whitespace — DC Intel" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <script is:inline>
      // Language bootstrap BEFORE first paint: without this, zh-preference readers get an
      // English flash on every page load (each navigation is a full page load — no SPA).
      // The toggle handler + persistence live in the body module script; this only reads.
      (function () {
        try {
          var saved = localStorage.getItem('ws-lang');
          if (saved === 'zh' || saved === 'en') {
            document.documentElement.dataset.lang = saved;
            document.documentElement.lang = saved === 'zh' ? 'zh-Hant' : 'en';
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-paper text-stone-900 font-sans antialiased min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:z-[60] focus:top-2 focus:left-2 focus:bg-white focus:px-3 focus:py-2 focus:rounded focus:shadow"
    >
      <Bi en="Skip to content" zh="跳至內容" />
    </a>

    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-t-[3px] border-t-gold border-b border-b-stone-200 shadow-sm relative overflow-hidden">
      {/* Easter-egg layer: a batik (kawung) pattern that sweeps across the masthead when the
          logo mark is clicked 5x. Hidden (opacity 0) until triggered. */}
      <div data-batik aria-hidden="true" style="opacity:0" class="batik-overlay pointer-events-none absolute inset-0">
        <svg class="w-full h-full text-gold" preserveAspectRatio="xMidYMid slice">
          <defs>
            <pattern id="batik-kawung" width="40" height="40" patternUnits="userSpaceOnUse">
              {/* Kawung: a quatrefoil of four lens/petal shapes around a center, plus the
                  scattered "cecek" filler dots that make batik read as batik. */}
              <g fill="none" stroke="currentColor" stroke-width="1">
                <ellipse cx="20" cy="8" rx="6" ry="9" />
                <ellipse cx="20" cy="32" rx="6" ry="9" />
                <ellipse cx="8" cy="20" rx="9" ry="6" />
                <ellipse cx="32" cy="20" rx="9" ry="6" />
                <ellipse cx="20" cy="8" rx="3" ry="5" />
                <ellipse cx="20" cy="32" rx="3" ry="5" />
                <ellipse cx="8" cy="20" rx="5" ry="3" />
                <ellipse cx="32" cy="20" rx="5" ry="3" />
              </g>
              <g fill="currentColor">
                <circle cx="20" cy="20" r="1.8" />
                <circle cx="0" cy="0" r="1.4" />
                <circle cx="40" cy="0" r="1.4" />
                <circle cx="0" cy="40" r="1.4" />
                <circle cx="40" cy="40" r="1.4" />
                <circle cx="20" cy="2" r="0.9" />
                <circle cx="2" cy="20" r="0.9" />
                <circle cx="38" cy="20" r="0.9" />
                <circle cx="20" cy="38" r="0.9" />
              </g>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#batik-kawung)" />
        </svg>
      </div>
      <div class="max-w-6xl mx-auto px-4 relative z-10">
        <div class="flex items-center justify-between h-14">
          <a href={base} class="flex items-baseline gap-2 hover:opacity-80 transition" aria-label="Whitespace — DC Intel, home">
            {/* Mark = an empty outlined square: literally "white space". Also the egg trigger. */}
            <svg
              data-egg-trigger
              width="15"
              height="15"
              viewBox="0 0 16 16"
              aria-hidden="true"
              class="shrink-0 translate-y-[2px] text-accent"
            >
              <rect x="2" y="2" width="12" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="1.75" />
            </svg>
            {/* Wordmark IS the logo: serif nameplate, the weight fading from "White" into
                "space" so the word visually empties out — the concept, in the type itself. */}
            <span class="font-serif text-xl tracking-tight leading-none">
              <span class="font-bold text-stone-900">White</span><span class="font-normal text-stone-500">space</span>
            </span>
            <span class="font-mono text-[11px] uppercase tracking-wider text-stone-500" data-en lang="en">DC Intel</span>
            <span class="text-xs text-stone-500" data-zh lang="zh-Hant">資料中心情報</span>
          </a>
          <div class="flex items-center gap-4">
            {
              statLine && (
                <span class="hidden md:inline">
                  <span data-en lang="en" class="font-mono text-[11px] uppercase tracking-wider text-stone-500">
                    {statLine.en}
                  </span>
                  <span data-zh lang="zh-Hant" class="text-xs text-stone-500">
                    {statLine.zh}
                  </span>
                </span>
              )
            }
            <button
              id="lang-toggle"
              class="px-3 py-1.5 text-xs font-medium border border-stone-300 rounded-md hover:bg-stone-100 transition min-h-[44px]"
              aria-label="Switch to Chinese"
            >
              <span data-en lang="en">中文</span>
              <span data-zh lang="zh-Hant">EN</span>
            </button>
          </div>
        </div>
        <nav aria-label="Categories" class="overflow-x-auto -mx-4 px-4 pb-2">
          <ul class="flex gap-2 text-sm whitespace-nowrap">
            <li>
              <a
                href={base}
                aria-current={isHome ? 'page' : undefined}
                class:list={[
                  'px-3 py-1.5 rounded-md font-medium transition inline-flex items-center min-h-[40px]',
                  isHome ? 'bg-stone-100 text-stone-900' : 'text-stone-900 hover:bg-stone-100',
                ]}
              >
                <Bi en="Home" zh="首頁" />
              </a>
            </li>
            <li aria-hidden="true" class="self-center text-stone-200 select-none">|</li>
            {
              CATEGORIES.map((cat) => (
                <li>
                  <a
                    href={catHref(cat.slug)}
                    aria-current={isActiveCat(cat.slug) ? 'page' : undefined}
                    class:list={[
                      'px-3 py-1.5 rounded-md transition inline-flex items-center min-h-[40px]',
                      isActiveCat(cat.slug)
                        ? 'bg-stone-900 text-white'
                        : 'text-stone-600 hover:bg-stone-100 hover:text-stone-900',
                    ]}
                  >
                    <Bi en={cat.en} zh={cat.zh} />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-stone-200 mt-16 py-8 text-center text-xs text-stone-600">
      <Bi en="Internal — Whitespace DC team" zh="內部 — Whitespace 資料中心團隊" />
    </footer>

    {/* Back-to-top: hidden until the reader scrolls down, then jumps to the top. Navy disc
        with a gold hairline ring (the masthead metals), 44px touch target, keyboard-reachable. */}
    <button
      id="to-top"
      type="button"
      aria-label="Back to top"
      class="fixed bottom-5 right-5 z-40 grid place-items-center w-11 h-11 rounded-full bg-accent text-white ring-1 ring-gold/60 shadow-lg opacity-0 translate-y-2 pointer-events-none transition-all duration-300 hover:bg-stone-900 focus-visible:opacity-100"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 19V6M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <dialog
      id="internal-warning"
      class="m-auto w-[calc(100%-2rem)] max-w-md rounded-lg p-0 shadow-2xl backdrop:bg-black/60"
      aria-labelledby="iw-title"
    >
      <div class="p-6">
        <h2 id="iw-title" class="text-lg font-semibold mb-3">
          <Bi en="Internal Use Only" zh="僅限內部使用" />
        </h2>
        <p class="text-sm text-stone-700 mb-4 leading-relaxed">
          <span data-en lang="en">
            Whitespace is restricted to the internal data center planning team. Do not share,
            redistribute, screenshot for external audiences, or quote content beyond the team
            without permission.
          </span>
          <span data-zh lang="zh-Hant">
            Whitespace 僅限資料中心規劃團隊內部使用。未經許可，請勿對外分享、轉發、截圖給團隊外人員或引用內容。
          </span>
        </p>
        <button
          id="iw-ack"
          class="w-full px-4 py-2 bg-stone-900 text-white rounded hover:bg-stone-800 text-sm font-medium transition min-h-[44px]"
        >
          <Bi en="I understand" zh="我已知悉" />
        </button>
      </div>
    </dialog>

    <script>
      // Bilingual toggle: flips data-lang AND html.lang (so screen readers pick the right
      // voice for the whole page — the previous version never updated html.lang).
      const LANG_KEY = 'ws-lang';
      const html = document.documentElement;
      const langBtn = document.getElementById('lang-toggle');
      const applyLang = (next: string) => {
        html.dataset.lang = next;
        html.lang = next === 'zh' ? 'zh-Hant' : 'en';
        // The toggle is a state control: expose which language a press switches TO,
        // so screen-reader users know the current state. (The head bootstrap script
        // sets lang before paint but can't reach this button — it renders later.)
        langBtn?.setAttribute('aria-label', next === 'zh' ? 'Switch to English' : 'Switch to Chinese');
      };
      const saved = localStorage.getItem(LANG_KEY);
      if (saved === 'zh' || saved === 'en') applyLang(saved);

      langBtn?.addEventListener('click', () => {
        const next = html.dataset.lang === 'en' ? 'zh' : 'en';
        applyLang(next);
        localStorage.setItem(LANG_KEY, next);
      });

      // Internal-use notice — native <dialog> gives focus-trap, Esc, and inert backdrop
      // for free (the old hand-rolled modal had none). Shown once per device.
      const ACK_KEY = 'ws-internal-ack';
      const modal = document.getElementById('internal-warning') as HTMLDialogElement | null;
      if (modal && !localStorage.getItem(ACK_KEY)) modal.showModal();
      document.getElementById('iw-ack')?.addEventListener('click', () => {
        localStorage.setItem(ACK_KEY, '1');
        modal?.close();
      });

      // Keep the date dividers' sticky offset exactly equal to the live header height
      // (the chips can wrap / the font can scale), so they never overlap or leave a gap.
      // Replaces the hardcoded top-[6.75rem] magic number with a measured CSS var.
      const headerEl = document.querySelector('header');
      const syncHeaderH = () => {
        if (headerEl) html.style.setProperty('--header-h', `${headerEl.offsetHeight}px`);
      };
      syncHeaderH();
      if (headerEl && 'ResizeObserver' in window) new ResizeObserver(syncHeaderH).observe(headerEl);
      window.addEventListener('resize', syncHeaderH);

      // Back-to-top: reveal once scrolled past one viewport, hide near the top.
      const toTop = document.getElementById('to-top');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const onScroll = () => {
        const show = window.scrollY > window.innerHeight * 0.6;
        toTop?.classList.toggle('opacity-0', !show);
        toTop?.classList.toggle('translate-y-2', !show);
        toTop?.classList.toggle('pointer-events-none', !show);
        // pointer-events-none blocks mouse but NOT Tab focus — `inert` removes the hidden
        // button from the tab order + a11y tree so it can't be focused while invisible.
        if (toTop) toTop.inert = !show;
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      toTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      });

      // Easter egg: click the logo mark 5x (within 1.5s between clicks) -> a batik sweep
      // across the masthead. The mark lives inside the home link, so suppress navigation.
      const eggMark = document.querySelector('[data-egg-trigger]');
      const batik = document.querySelector('[data-batik]');
      let eggN = 0;
      let eggT: ReturnType<typeof setTimeout>;
      eggMark?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        eggN += 1;
        clearTimeout(eggT);
        eggT = setTimeout(() => { eggN = 0; }, 1500);
        if (eggN >= 5 && batik && !batik.classList.contains('run')) {
          eggN = 0;
          batik.classList.add('run');
          setTimeout(() => batik.classList.remove('run'), 1900);
        }
      });
    </script>

    <script is:inline>
      // Easter egg: a console greeting. Invisible in normal use — a wink for anyone who
      // opens devtools. Static text only.
      console.log('%cSelamat Datang 👋', 'font-size:26px;font-weight:700;color:#1e3a5f;');
      console.log(
        '%cWhitespace%c — independent data-center intelligence. Corroborated, multi-source, signal over hype. Built for the team.',
        'color:#b08d57;font-weight:700;',
        'color:#1e3a5f;'
      );
      console.log(
        '%cWhitespace — 獨立的資料中心情報。多方佐證、去蕪存菁，為團隊打造。',
        'color:#1e3a5f;'
      );
    </script>

    <style is:global>
      html[data-lang='en'] [data-zh] {
        display: none !important;
      }
      html[data-lang='zh'] [data-en] {
        display: none !important;
      }
    </style>
  </body>
</html>
