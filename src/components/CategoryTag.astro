---
import { CATEGORIES } from '../data/categories';

// One calm category tag, shared everywhere (home hero, cards, article header) so the
// treatment lives in ONE place. Rendered as a micro-label so readers parse it as a
// metadata TAG, not as a continuation of the serif summary prose. No filled pill, no dot
// — the headline still leads; the category reads unmistakably as a label.
//
// EN uses the mono UPPERCASE "eyebrow" voice (same as dates/section labels). zh-Hant gets a
// plain small treatment instead: mono has no CJK glyphs and letter-spacing/uppercase do not
// read on CJK, so the label-ness comes from size + muted colour. Mirrors the masthead
// kicker ("DC Intel" mono / "資料中心情報" plain) — see BaseLayout. Hence the spans are
// emitted directly (not via <Bi>, which would force one shared class onto both languages).
interface Props {
  slug: string;
  secondary?: boolean; // quieter variant for an article's secondary categories
}
const { slug, secondary = false } = Astro.props;
const cat = CATEGORIES.find((c) => c.slug === slug);
const en = cat?.en ?? slug;
const zh = cat?.zh ?? slug;
// Secondary tags differ by WEIGHT, not lightness: stone-400 at 11px measured 2.52:1
// on white — below WCAG 4.5:1. stone-500 measures 4.80:1; weight carries the hierarchy.
const enWeight = secondary ? 'font-normal' : 'font-semibold';
const zhWeight = secondary ? 'font-normal' : 'font-medium';
---
<span data-en lang="en" class:list={['font-mono text-[11px] uppercase tracking-wider text-stone-500', enWeight]}>{en}</span><span data-zh lang="zh-Hant" class:list={['text-xs text-stone-500', zhWeight]}>{zh}</span>
