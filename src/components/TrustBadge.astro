---
import Bi from './Bi.astro';

// Sourcing confidence from the synthesis pipeline, framed as a POSITIVE signal — never
// a "3/5" score that reads as a verdict on whether the article is true (which made
// readers TRUST the site less). No number, no alarm colours. Mono micro-label = telemetry
// /status feel. Full reasoning still lives on the article page (hover title + Why block).
interface Props {
  score: number;
  reasoning?: string;
}
const { score, reasoning } = Astro.props;
const tier =
  score >= 4
    ? { en: 'Verified', zh: '已核實', check: true, cls: 'text-emerald-700' }
    : score === 3
      ? { en: 'Corroborated', zh: '多方佐證', check: false, cls: 'text-stone-500' }
      : { en: 'Single source', zh: '單一來源', check: false, cls: 'text-stone-500' };
---
<span
  class:list={['inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-wider', tier.cls]}
  title={reasoning}
>
  {tier.check && (
    <svg aria-hidden="true" class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.3 3.3 6.8-6.8a1 1 0 0 1 1.4 0z"
        clip-rule="evenodd"
      />
    </svg>
  )}
  <Bi en={tier.en} zh={tier.zh} />
</span>
