---
import { dateline } from '../data/regions';

// Ambient geography: a journalistic dateline (pin + country names, country-scale only).
// Display-only — making it interactive inside a card link would nest interactive elements
// (invalid + a11y fail); the Region Lens pill is the filter entry point. Pseudo-tokens
// like "global" are dropped by dateline(); no countries -> renders nothing.
interface Props {
  region: string[];
  class?: string;
}
const { region, class: cls } = Astro.props;
const { shown, extra } = dateline(region ?? []);
---
{
  shown.length > 0 && (
    <span class={`inline-flex items-center gap-1 text-slate-500 ${cls ?? ''}`}>
      <svg aria-hidden="true" class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
      </svg>
      <span class="font-medium tracking-wide uppercase text-[11px]">
        {shown.join(', ')}
        {extra > 0 ? ` +${extra}` : ''}
      </span>
    </span>
  )
}
