---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../data/categories';
import { regionGroupsFor } from '../data/regions';
import Bi from './Bi.astro';
import Dateline from './Dateline.astro';
import TrustBadge from './TrustBadge.astro';

// The list/feed card, shared by home (Latest), category, and region pages so the design
// lives in ONE place. Carries data-category + data-region (group slugs) so the Region
// Lens can filter it client-side. Meta row order: dateline · category · date · trust.
interface Props {
  post: CollectionEntry<'news'>;
  base: string;
  // Home only: this post also leads the Top Stories hero. Hidden in the default Latest
  // list (no duplicate), but data-featured lets the Region Lens reveal it when filtering
  // (so a featured story that matches the place isn't lost when the hero is hidden).
  featured?: boolean;
}
const { post, base, featured = false } = Astro.props;
const d = post.data;
const cat = CATEGORIES.find((c) => c.slug === d.category);
const regionSlugs = regionGroupsFor(d.region ?? []).join(' ');
const dateStr = d.date.toISOString().slice(0, 10);
---
<article
  data-article
  data-category={d.category}
  data-region={regionSlugs}
  data-featured={featured ? '' : undefined}
  hidden={featured}
  class="bg-white border border-slate-200 rounded-lg p-4 sm:p-5 hover:border-slate-400 transition"
>
  <header class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs mb-2">
    <Dateline region={d.region ?? []} />
    <span class={`px-2 py-0.5 rounded border font-medium ${cat?.chip ?? 'bg-slate-100 text-slate-700 border-slate-200'}`}>
      <Bi en={cat?.en ?? d.category} zh={cat?.zh ?? d.category} />
    </span>
    <span class="tabular-nums text-slate-500">{dateStr}</span>
    <TrustBadge score={d.trust.score} reasoning={d.trust.reasoning} />
  </header>
  <h3 class="text-lg font-semibold leading-snug mb-1">
    <a href={`${base}/news/${post.id}`} class="hover:text-indigo-700 transition">
      <Bi en={d.title_en} zh={d.title_zh} />
    </a>
  </h3>
  <p class="text-sm text-slate-600 leading-relaxed line-clamp-2">
    <Bi en={d.summary_en} zh={d.summary_zh} />
  </p>
</article>
