---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../data/categories';
import Bi from '../components/Bi.astro';
import Dateline from '../components/Dateline.astro';
import TrustBadge from '../components/TrustBadge.astro';
import ArticleCard from '../components/ArticleCard.astro';
import RegionLens from '../components/RegionLens.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allPosts = await getCollection('news');

const FEATURED_COUNT = 5;
const RECENCY_WINDOW_DAYS = 10;

const byDateDesc = (a: typeof allPosts[number], b: typeof allPosts[number]) =>
  b.data.date.valueOf() - a.data.date.valueOf();
const chronological = [...allPosts].sort(byDateDesc);

// "Top Stories" = most SIGNIFICANT recent (trust + multi-source corroboration), gated to a
// recency window, NOT merely newest. Tie-break by date.
const cutoff = Date.now() - RECENCY_WINDOW_DAYS * 86_400_000;
const importance = (p: typeof allPosts[number]) =>
  (p.data.trust?.score ?? 0) + Math.min((p.data.sources?.length ?? 1) - 1, 3);
const ranked = chronological
  .filter((p) => p.data.date.valueOf() >= cutoff)
  .sort((a, b) => importance(b) - importance(a) || byDateDesc(a, b));

const featured = ranked.slice(0, FEATURED_COUNT);
const have = new Set(featured);
for (const p of chronological) {
  if (featured.length >= FEATURED_COUNT) break;
  if (!have.has(p)) { featured.push(p); have.add(p); }
}
const featuredIds = new Set(featured.map((p) => p.id));
// Default view hides the featured rows in Latest (they lead the hero), so the count
// reflects what's actually visible below, not the full corpus.
const latestVisible = chronological.length - featuredIds.size;

const categoryLabel = (slug: string) => CATEGORIES.find((c) => c.slug === slug);
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Whitespace — DC Intel">
  <div class="flex items-center justify-end mb-6">
    <RegionLens posts={allPosts} />
  </div>

  {
    featured.length > 0 && (
      <section id="top-stories" class="mb-12">
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="eyebrow flex items-center gap-2">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-indigo-600" />
            <Bi en="Top Stories · most significant" zh="今日要聞 · 最具份量" />
          </h2>
          <span class="text-sm text-slate-500 tabular-nums">{today}</span>
        </div>

        {featured[0] && (() => {
          const post = featured[0];
          const cat = categoryLabel(post.data.category);
          return (
            <a
              href={`${base}/news/${post.id}`}
              class="group block bg-white border border-slate-200 rounded-xl p-6 sm:p-8 mb-4 hover:border-indigo-300 hover:shadow-md transition"
            >
              <header class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs mb-3">
                <Dateline region={post.data.region ?? []} />
                <span class={`px-2 py-0.5 rounded border font-medium ${cat?.chip ?? 'bg-slate-100 text-slate-700 border-slate-200'}`}>
                  <Bi en={cat?.en ?? post.data.category} zh={cat?.zh ?? post.data.category} />
                </span>
                <span class="tabular-nums text-slate-500">{isoDate(post.data.date)}</span>
                <TrustBadge score={post.data.trust.score} reasoning={post.data.trust.reasoning} />
              </header>
              <h3 class="text-2xl sm:text-3xl font-bold leading-tight mb-2 group-hover:text-indigo-700 transition">
                <Bi en={post.data.title_en} zh={post.data.title_zh} />
              </h3>
              <p class="text-slate-700 leading-relaxed line-clamp-3">
                <Bi en={post.data.summary_en} zh={post.data.summary_zh} />
              </p>
            </a>
          );
        })()}

        {featured.length > 1 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {featured.slice(1).map((post) => {
              const cat = categoryLabel(post.data.category);
              return (
                <a
                  href={`${base}/news/${post.id}`}
                  class="group block bg-white border border-slate-200 rounded-xl p-5 hover:border-indigo-300 hover:shadow-md transition"
                >
                  <header class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs mb-2">
                    <Dateline region={post.data.region ?? []} />
                    <span class={`px-2 py-0.5 rounded border font-medium ${cat?.chip ?? 'bg-slate-100 text-slate-700 border-slate-200'}`}>
                      <Bi en={cat?.en ?? post.data.category} zh={cat?.zh ?? post.data.category} />
                    </span>
                    <span class="tabular-nums text-slate-500">{isoDate(post.data.date)}</span>
                  </header>
                  <h3 class="text-lg font-semibold leading-snug mb-1 group-hover:text-indigo-700 transition">
                    <Bi en={post.data.title_en} zh={post.data.title_zh} />
                  </h3>
                  <p class="text-sm text-slate-600 leading-relaxed line-clamp-2">
                    <Bi en={post.data.summary_en} zh={post.data.summary_zh} />
                  </p>
                </a>
              );
            })}
          </div>
        )}
      </section>
    )
  }

  <section>
    <div class="flex items-baseline justify-between mb-4 border-b border-slate-200 pb-2">
      <h2 class="eyebrow">
        <Bi en="Latest" zh="最新" />
      </h2>
      <span class="text-xs text-slate-400">
        <Bi en={`${latestVisible} stories`} zh={`${latestVisible} 則`} />
      </span>
    </div>

    {
      chronological.length === 0 ? (
        <p class="text-slate-500 text-sm italic">
          <Bi en="No posts yet." zh="暫無內容。" />
        </p>
      ) : (
        <>
          <div class="space-y-3">
            {chronological.map((post) => (
              <ArticleCard post={post} base={base} featured={featuredIds.has(post.id)} />
            ))}
          </div>
          <p id="region-empty" hidden class="text-slate-500 text-sm italic mt-4">
            <Bi en="No stories for this place yet." zh="此地區暫無內容。" />
          </p>
        </>
      )
    }
  </section>
</BaseLayout>
