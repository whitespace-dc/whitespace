---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../data/categories';
import { renderArticleBody } from '../../lib/markdown';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const cat = CATEGORIES.find((c) => c.slug === post.data.category);
// Two dates: when Whitespace curated/published, and when the original source
// published. Showing both stops a days-old story from reading as breaking news.
const curatedStr = post.data.date.toISOString().slice(0, 10);
const sourceStr = post.data.source_published
  ? post.data.source_published.toISOString().slice(0, 10)
  : null;

// Full long-form body when the agent supplied one; otherwise the summary-only
// seed posts fall back to the summary paragraph below.
const bodyEnHtml = post.data.body_en ? renderArticleBody(post.data.body_en) : null;
const bodyZhHtml = post.data.body_zh ? renderArticleBody(post.data.body_zh) : null;
---

<BaseLayout title={post.data.title_en}>
  <article class="bg-white border border-slate-200 rounded-lg p-6 sm:p-8">
    <header class="mb-6 pb-4 border-b border-slate-100">
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-3">
        <span class="px-2 py-0.5 bg-slate-100 rounded font-medium text-slate-700">
          <span data-en>{cat?.en ?? post.data.category}</span>
          <span data-zh>{cat?.zh ?? post.data.category}</span>
        </span>
        <span class="tabular-nums" title="When Whitespace published this">
          <span data-en>Curated {curatedStr}</span>
          <span data-zh>整理 {curatedStr}</span>
        </span>
        {sourceStr && (
          <span class="tabular-nums text-slate-400" title="When the original source published">
            <span data-en>· Source {sourceStr}</span>
            <span data-zh>· 原文 {sourceStr}</span>
          </span>
        )}
        <span>
          <span data-en>Trust {post.data.trust.score}/5</span>
          <span data-zh>可信 {post.data.trust.score}/5</span>
        </span>
        {post.data.vendor.length > 0 && (
          <span class="text-slate-400">
            {post.data.vendor.join(', ')}
          </span>
        )}
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight leading-tight">
        <span data-en>{post.data.title_en}</span>
        <span data-zh>{post.data.title_zh}</span>
      </h1>
    </header>

    <div class="prose prose-slate max-w-none text-base leading-relaxed">
      {bodyEnHtml
        ? <div data-en set:html={bodyEnHtml} />
        : <p data-en class="whitespace-pre-line">{post.data.summary_en}</p>}
      {bodyZhHtml
        ? <div data-zh set:html={bodyZhHtml} />
        : <p data-zh class="whitespace-pre-line">{post.data.summary_zh}</p>}
    </div>

    <footer class="mt-8 pt-4 border-t border-slate-100">
      <h2 class="text-sm font-semibold text-slate-700 mb-2">
        <span data-en>Sources</span>
        <span data-zh>來源</span>
      </h2>
      <ul class="space-y-1.5 text-sm">
        {post.data.sources.map((src) => (
          <li>
            <a
              href={src.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-700 hover:text-slate-900 underline decoration-slate-300 hover:decoration-slate-700"
            >
              {src.title}
            </a>
            <span class="text-xs text-slate-400 ml-2">
              ({src.type === 'primary' ? 'primary' : 'corroborating'} · trust {src.trust}/5{src.published_at ? ` · ${src.published_at.toISOString().slice(0, 10)}` : ''})
            </span>
          </li>
        ))}
      </ul>
      <div class="mt-3 text-xs text-slate-500">
        <span data-en>{post.data.trust.reasoning}</span>
      </div>
    </footer>
  </article>

  <div class="mt-6">
    <a href={import.meta.env.BASE_URL} class="text-sm text-slate-600 hover:text-slate-900">
      <span data-en>← Back to latest</span>
      <span data-zh>← 返回最新</span>
    </a>
  </div>
</BaseLayout>
