---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../data/categories';
import Bi from '../../components/Bi.astro';
import Dateline from '../../components/Dateline.astro';
import CategoryTag from '../../components/CategoryTag.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { renderArticleBody } from '../../lib/markdown';
import { getCollection } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('news');
  const byDateDesc = (a: typeof posts[number], b: typeof posts[number]) =>
    b.data.date.valueOf() - a.data.date.valueOf();
  return posts.map((post) => {
    // Related = same primary category, newest first, excluding self.
    const related = posts
      .filter((p) => p.id !== post.id && p.data.category === post.data.category)
      .sort(byDateDesc)
      .slice(0, 3);
    return { params: { slug: post.id }, props: { post, related } };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, related } = Astro.props;
const cat = CATEGORIES.find((c) => c.slug === post.data.category);
const curatedStr = post.data.date.toISOString().slice(0, 10);
const sourceStr = post.data.source_published
  ? post.data.source_published.toISOString().slice(0, 10)
  : null;

// Sourcing signal (replaces the old "Trust X/5" badge): derived from the actual source
// list and shown next to the Sources heading, so the sourcing speaks for itself.
const sourceCount = post.data.sources.length;
const sourcing =
  sourceCount <= 1
    ? { en: 'Single source', zh: '單一來源' }
    : { en: `Corroborated · ${sourceCount} sources`, zh: `多方佐證 · ${sourceCount} 則` };

const bodyEnHtml = post.data.body_en ? renderArticleBody(post.data.body_en) : null;
const bodyZhHtml = post.data.body_zh ? renderArticleBody(post.data.body_zh) : null;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={post.data.title_en}>
  <article class="bg-white border border-stone-200 rounded-lg p-6 sm:p-8" data-pagefind-meta={`title:${post.data.title_en}`}>
    <header class="mb-6 pb-4 border-b border-stone-100">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-stone-500 mb-3">
        <Dateline region={post.data.region ?? []} />
        <CategoryTag slug={post.data.category} />
        {(post.data.secondary_categories ?? []).map((slug) => (
          <CategoryTag slug={slug} secondary />
        ))}
        <span class="font-mono tabular-nums" title="When Whitespace published this">
          <Bi en={`Curated ${curatedStr}`} zh={`整理 ${curatedStr}`} />
        </span>
        {sourceStr && (
          <span class="font-mono tabular-nums text-stone-500" title="When the original source published">
            <Bi en={`· Source ${sourceStr}`} zh={`· 原文 ${sourceStr}`} />
          </span>
        )}
      </div>
      <h1 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight leading-tight">
        <Bi en={post.data.title_en} zh={post.data.title_zh} />
      </h1>
    </header>

    <div class="prose prose-stone font-serif max-w-prose text-base leading-relaxed">
      {bodyEnHtml
        ? <div data-en lang="en" data-pagefind-body set:html={bodyEnHtml} />
        : <p data-en lang="en" data-pagefind-body class="whitespace-pre-line">{post.data.summary_en}</p>}
      {bodyZhHtml
        ? <div data-zh lang="zh-Hant" data-pagefind-body set:html={bodyZhHtml} />
        : <p data-zh lang="zh-Hant" data-pagefind-body class="whitespace-pre-line">{post.data.summary_zh}</p>}
    </div>

    <footer class="mt-8 pt-4 border-t border-stone-100 max-w-prose">
      <div class="flex items-baseline justify-between gap-3 mb-2">
        <h2 class="text-sm font-semibold text-stone-700">
          <Bi en="Sources" zh="來源" />
        </h2>
        <span class="font-mono text-[11px] uppercase tracking-wider text-stone-500">
          <Bi en={sourcing.en} zh={sourcing.zh} />
        </span>
      </div>
      <ul class="space-y-1.5 text-sm">
        {post.data.sources.map((src) => (
          <li>
            <a
              href={src.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-700 hover:text-stone-900 underline decoration-stone-300 hover:decoration-stone-700"
            >
              {src.title}
              <span class="sr-only"><Bi en="(opens in new tab)" zh="(在新分頁開啟)" /></span>
            </a>
            <span class="text-xs text-stone-500 ml-2">
              {src.type === 'primary'
                ? <Bi en="primary source" zh="主要來源" />
                : <Bi en="corroborating source" zh="佐證來源" />}
            </span>
          </li>
        ))}
      </ul>
    </footer>
  </article>

  {
    related.length > 0 && (
      <section class="mt-10">
        <h2 class="eyebrow mb-3">
          <Bi en={`More in ${cat?.en ?? post.data.category}`} zh={`更多${cat?.zh ?? post.data.category}`} />
        </h2>
        <div class="space-y-3">
          {related.map((p) => <ArticleCard post={p} base={base} />)}
        </div>
      </section>
    )
  }

  <div class="mt-6">
    <a href={base} class="text-sm text-stone-600 hover:text-stone-900">
      <Bi en="← Back to home" zh="← 返回首頁" />
    </a>
  </div>
</BaseLayout>
