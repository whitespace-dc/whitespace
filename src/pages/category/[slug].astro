---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../data/categories';
import Bi from '../../components/Bi.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RegionLens from '../../components/RegionLens.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

export const getStaticPaths = (async () => {
  return CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { category } = Astro.props;
const allPosts = await getCollection('news');
// Cross-list: an article appears under its primary AND every secondary category.
const posts = allPosts
  .filter(
    (p) =>
      p.data.category === category.slug ||
      (p.data.secondary_categories ?? []).some((s) => s === category.slug),
  )
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${category.en} — Whitespace`}>
  <section class="mb-6">
    <a href={base} class="text-sm text-stone-500 hover:text-stone-700">
      <Bi en="← Home" zh="← 首頁" />
    </a>
    <div class="flex items-start justify-between gap-4 mt-2">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">
          <Bi en={category.en} zh={category.zh} />
        </h1>
        <p class="text-sm text-stone-500 mt-1">
          <Bi en={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`} zh={`${posts.length} 篇`} />
        </p>
      </div>
      <RegionLens posts={posts} />
    </div>
  </section>

  {
    posts.length === 0 ? (
      <p class="text-stone-500 text-sm italic">
        <Bi en="No posts in this category yet." zh="此類別暫無內容。" />
      </p>
    ) : (
      <>
        <div class="space-y-3">
          {posts.map((post) => (
            <ArticleCard post={post} base={base} />
          ))}
        </div>
        <p id="region-empty" hidden class="text-stone-500 text-sm italic mt-4">
          <Bi en="No stories for this place in this category." zh="此地區於此類別暫無內容。" />
        </p>
      </>
    )
  }
</BaseLayout>
