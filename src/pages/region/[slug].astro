---
import { REGION_GROUPS } from '../../data/regions';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

// Deep-link entry: /region/<slug> is a shareable/canonical URL that lands the reader on
// the home feed with the region lens pre-applied. Region is a lens over the feed, not a
// page tree of its own, so this just redirects to /?region=<slug>. Static-host friendly
// (meta-refresh + JS replace + visible fallback link).
export const getStaticPaths = (async () => {
  return REGION_GROUPS.map((group) => ({
    params: { slug: group.slug },
    props: { group },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { group } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/?region=${group.slug}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{group.en} — Whitespace</title>
  </head>
  <body>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)})`}></script>
    <p>Redirecting to <a href={target}>{group.en}</a>…</p>
  </body>
</html>
