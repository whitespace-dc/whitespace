---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bi from '../components/Bi.astro';

// GitHub Pages serves 404.html automatically for any unknown path — without this
// file, readers got GitHub's default 404 with no way back into the site.
const base = import.meta.env.BASE_URL;
const homeHref = base.replace(/\/$/, '') || '/';
---

<BaseLayout title="Not found — Whitespace" description="Page not found.">
  <section class="max-w-prose mx-auto text-center py-16">
    <p class="eyebrow mb-4">404</p>
    <h1 class="font-serif text-3xl font-bold tracking-tight mb-3">
      <Bi en="This page doesn't exist" zh="找不到此頁面" />
    </h1>
    <p class="text-stone-600 mb-8 leading-relaxed">
      <Bi
        en="The link may be stale, or the story may have been superseded by a newer report."
        zh="連結可能已失效，或此報導已被較新的報導取代。"
      />
    </p>
    <a
      href={homeHref}
      class="inline-flex items-center justify-center px-5 py-2 min-h-[44px] rounded-md bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition"
    >
      <Bi en="Back to home — search lives there" zh="返回首頁 — 可於首頁搜尋" />
    </a>
  </section>
</BaseLayout>
